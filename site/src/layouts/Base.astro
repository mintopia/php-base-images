---
import '../styles/site.css';
import { versionKeys, repoUrl } from '../lib/data';

interface Props {
  title: string;
  description: string;
  current: 'home' | 'images' | 'matrix' | 'usage' | 'changelog';
}
const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  ['images', 'Images', `${base}images/`],
  ['matrix', 'Matrix', `${base}matrix/`],
  ['usage', 'Usage', `${base}usage/`],
  ['changelog', 'Changelog', `${base}changelog/`],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" href={`${base}llms.txt`} type="text/plain" title="llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base}>
        <span class="brand-lines" aria-hidden="true">
          {versionKeys.map((v) => <i data-line={v} style="background: var(--line)" />)}
        </span>
        mintopia/php
      </a>
      <nav class="site-nav" aria-label="Main">
        {nav.map(([id, label, href]) => <a href={href} aria-current={id === current ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <span>Multi-arch PHP images on <code>ghcr.io/mintopia</code>, signed with cosign.</span>
      <a href={repoUrl}>Source on GitHub</a>
    </footer>
    <p class="sr-only" aria-live="polite" id="copy-status"></p>
    <script>
      document.addEventListener('click', async (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
        if (!btn) return;
        const status = document.getElementById('copy-status')!;
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
        } catch {
          status.textContent = 'Copy failed. Select the text and copy it manually.';
          return;
        }
        status.textContent = 'Copied';
        btn.dataset.copied = '';
        setTimeout(() => { delete btn.dataset.copied; status.textContent = ''; }, 1400);
      });
    </script>
  </body>
</html>
