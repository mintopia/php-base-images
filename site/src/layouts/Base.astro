---
import '../styles/site.css';
import { Font } from 'astro:assets';
import { versionKeys, repoUrl, fmtTime, siteBuilt as built } from '../lib/data';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'images' | 'matrix' | 'usage' | 'changelog' | 'about';
}
const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  ['images', 'Images', `${base}images/`],
  ['matrix', 'Matrix', `${base}matrix/`],
  ['usage', 'Usage', `${base}usage/`],
  ['changelog', 'Changelog', `${base}changelog/`],
  ['about', 'About', `${base}about/`],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" href={`${base}llms.txt`} type="text/plain" title="llms.txt" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mintopia/php" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-jbmono" preload />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base}>
        <span class="brand-lines" aria-hidden="true">
          {versionKeys.map((v) => <i data-line={v} />)}
        </span>
        mintopia/php
      </a>
      <nav class="site-nav" aria-label="Main">
        {nav.map(([id, label, href]) => <a href={href} aria-current={id === current ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <span>Multi-arch PHP images on <code>ghcr.io/mintopia</code>.</span>
      <a href={repoUrl}>Source on GitHub</a>
      <span>Site built <time class="mono" datetime={built}>{fmtTime(built)} UTC</time></span>
    </footer>
    <a class="to-top" href="#content">Back to top</a>
    <p class="sr-only" aria-live="polite" id="copy-status"></p>
    <script>
      const toTop = document.querySelector<HTMLElement>('.to-top')!;
      const showToTop = () => toTop.classList.toggle('shown', scrollY > innerHeight * 1.5);
      addEventListener('scroll', showToTop, { passive: true });
      showToTop();

      document.addEventListener('click', async (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
        if (!btn) return;
        if (btn.hasAttribute('data-copied') || btn.hasAttribute('data-failed')) return;
        const status = document.getElementById('copy-status')!;
        const label = btn.querySelector<HTMLElement>('.label')!;
        const was = label.textContent;
        // label turns over like a board flap; width held so the button doesn't jump
        const show = (text: string) => {
          label.textContent = text;
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) label.animate(
            [{ transform: 'perspective(200px) rotateX(-90deg)', opacity: 0.3 }, { transform: 'none', opacity: 1 }],
            { duration: 180, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
          );
        };
        let state = 'copied';
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
          status.textContent = 'Copied';
        } catch {
          state = 'failed';
          status.textContent = 'Copy failed. Select the text and copy it manually.';
        }
        btn.style.minWidth = `${btn.offsetWidth}px`;
        btn.setAttribute(`data-${state}`, '');
        show(state === 'copied' ? 'Copied' : 'Copy failed');
        setTimeout(() => {
          btn.removeAttribute(`data-${state}`);
          btn.style.minWidth = '';
          status.textContent = '';
          show(was!);
        }, state === 'copied' ? 1400 : 2400);
      });
    </script>
  </body>
</html>
