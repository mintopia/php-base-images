---
import '../styles/site.css';
import { Font } from 'astro:assets';
import { versionKeys, repoUrl } from '../lib/data';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'images' | 'matrix' | 'usage' | 'changelog';
}
const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  ['images', 'Images', `${base}images/`],
  ['matrix', 'Matrix', `${base}matrix/`],
  ['usage', 'Usage', `${base}usage/`],
  ['changelog', 'Changelog', `${base}changelog/`],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" href={`${base}llms.txt`} type="text/plain" title="llms.txt" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mintopia/php" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-jbmono" preload />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base}>
        <span class="brand-lines" aria-hidden="true">
          {versionKeys.map((v) => <i data-line={v} />)}
        </span>
        mintopia/php
      </a>
      <nav class="site-nav" aria-label="Main">
        {nav.map(([id, label, href]) => <a href={href} aria-current={id === current ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <span>Multi-arch PHP images on <code>ghcr.io/mintopia</code>.</span>
      <a href={repoUrl}>Source on GitHub</a>
    </footer>
    <p class="sr-only" aria-live="polite" id="copy-status"></p>
    <script>
      document.addEventListener('click', async (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
        if (!btn) return;
        const status = document.getElementById('copy-status')!;
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
        } catch {
          status.textContent = 'Copy failed. Select the text and copy it manually.';
          return;
        }
        if (btn.hasAttribute('data-copied')) return;
        const label = btn.querySelector('.label')!;
        const was = label.textContent;
        label.textContent = status.textContent = 'Copied';
        btn.dataset.copied = '';
        setTimeout(() => { delete btn.dataset.copied; label.textContent = was; status.textContent = ''; }, 1400);
      });
    </script>
  </body>
</html>
