---
import Copy from './Copy.astro';
import { type Image, type Cve, imagePath } from '../lib/data';

interface Props { img: Image; cves: Cve[]; live: boolean }
const { img, cves, live } = Astro.props;
const php = cves.some((c) => c.pkg === 'php');
const os = cves.filter((c) => !c.kind && c.fixed);
const upstream = cves.filter((c) => c.kind && c.pkg !== 'php' && c.fixed);
const names = [...new Set(upstream.map((c) => c.pkg))];
const inLive = new Set(img.current?.cves?.map((c) => c.id));
const liveHas = (list: Cve[]) => !live && list.every((c) => !inLive.has(c.id));
const fix = php && img.parent ? `${img.parent.repo}:${img.parent.tag}` : null;
---
<p class="note">
  {php && <>The PHP CVEs are fixed by a newer PHP release{img.parent ? <>, which <a href={imagePath(img.parent)}><code>{img.parent.tag}</code></a> tracks</> : <>; a build with it follows once that release is out</>}. </>}
  {os.length > 0 && (liveHas(os) ? 'The live build of this tag has the OS package fixes. ' : 'The next daily check rebuilds this tag with the OS package fixes. ')}
  {names.length > 0 && <>{liveHas(upstream) ? 'The live build of this tag has the fixes for ' : 'Fixes for '}{names.map((p, i) => <>{i > 0 && ', '}<code>{p}</code></>)}{liveHas(upstream) ? '.' : ' come with newer upstream releases, which the daily check builds once they ship.'}</>}
</p>
{fix && (
  <dl class="refs">
    <div><dt>Use instead</dt><dd><code tabindex="0">{fix}</code><Copy text={fix} /></dd></div>
  </dl>
)}
