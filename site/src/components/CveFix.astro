---
import Copy from './Copy.astro';
import { type Image, type Cve, imagePath } from '../lib/data';

interface Props { img: Image; cves: Cve[]; live: boolean }
const { img, cves, live } = Astro.props;
const php = cves.some((c) => c.pkg === 'php');
const os = cves.some((c) => c.pkg !== 'php' && c.fixed);
const fix = php && img.parent ? `${img.parent.repo}:${img.parent.tag}` : null;
---
<p class="note">
  {php && <>The PHP CVEs are fixed by a newer PHP release{img.parent ? <>, which <a href={imagePath(img.parent)}><code>{img.parent.tag}</code></a> tracks</> : <>; a build with it follows that release</>}. </>}
  {os && (live ? 'The next daily check rebuilds this image with the OS package fixes.' : 'The live build of this tag carries the OS package fixes once rebuilt.')}
</p>
{fix && (
  <dl class="refs">
    <div><dt>Use instead</dt><dd><code>{fix}</code></dd><Copy text={fix} /></div>
  </dl>
)}
