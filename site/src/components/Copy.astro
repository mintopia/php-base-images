---
interface Props { text: string; label?: string; primary?: boolean }
const { text, label = 'Copy', primary } = Astro.props;
---
<button type="button" class:list={['btn', { primary }]} data-copy={text} aria-label={`Copy ${text}`}>
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.5" /></svg>
  <span class="label">{label}</span>
</button>
