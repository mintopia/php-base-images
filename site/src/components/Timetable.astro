---
import Bullet from './Bullet.astro';
import { type Image, fmtDate, shortDigest, commitUrl, buildPath, imagePath, criticals } from '../lib/data';

interface Props { img: Image; current?: string }
const { img, current } = Astro.props;
---
{img.builds.length === 0 ? (
  <p class="muted empty">No builds recorded yet. History starts with the next published build.</p>
) : (
  <div class="table-wrap">
    <table class="timetable">
      <caption class="sr-only">Build history</caption>
      <thead><tr><th scope="col">Built (UTC)</th><th scope="col">Change</th><th scope="col" class="wide">Digest</th><th scope="col" class="wide">Commit</th><th scope="col">Status</th></tr></thead>
      <tbody>
        {img.builds.map((r) => (
          <tr class:list={{ live: r.live, here: r.digest === current }}>
            <td class="mono"><a href={buildPath(img, r)} aria-current={r.digest === current ? 'page' : undefined}><span class="nw">{fmtDate(r.time)}</span> <span class="nw">{r.time.slice(11, 16)}</span></a></td>
            <td><div class="changes">
              {r.changes.map((c) => c.kind === 'php'
                ? <span class="php-change"><Bullet version={img.version} size="sm" />{c.text.replace(/^PHP /, '')}</span>
                : c.kind === 'component'
                ? <span class="chip">{c.text}</span>
                : <span class="muted">{c.text}</span>)}
            </div></td>
            <td class="mono muted wide" title={r.digest}>{shortDigest(r.digest)}</td>
            <td class="mono wide">{r.commit ? <a href={commitUrl(r.commit)}>{r.commit.slice(0, 7)}</a> : <span class="muted" title="Commit not recorded">—</span>}</td>
            <td><div class="changes">{r.live ? <span class="status">Live</span> : <span class="status old">Superseded</span>}{criticals(r) > 0 && <span class="cve">{criticals(r)} critical CVE{criticals(r) === 1 ? '' : 's'}</span>}</div></td>
          </tr>
        ))}
        {img.previous && (
          <tr class="prev"><td colspan={5}><span class="muted">Previous version:</span> <a class="mono" href={imagePath(img.previous)}>{img.previous.patch}</a></td></tr>
        )}
      </tbody>
    </table>
  </div>
)}
