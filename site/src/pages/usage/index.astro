---
import Base from '../../layouts/Base.astro';
import Code from '../../components/Code.astro';
import { latestStable, readmeTable } from '../../lib/data';

const v = latestStable;
const php = 'ghcr.io/mintopia/php';
const proxyRanges = await readmeTable('| In front of the container |');
const verify = `cosign verify ${php}:${v} \\
  --certificate-identity-regexp '^https://github\\.com/mintopia/php-base-images/\\.github/workflows/' \\
  --certificate-oidc-issuer https://token.actions.githubusercontent.com`;

const one = `services:
  app:
    image: ${php}:${v}-php-fpm-nginx
    ports:
      - "8080:8080"
    volumes:
      - "./:/app"
    environment:
      PUID: 1000`;
const two = `services:
  web:
    image: ghcr.io/mintopia/nginx:alpine
    ports:
      - "8080:8080"
    volumes:
      - "./public:/app/public:ro"
    environment:
      PHP_FPM_HOST: php
  php:
    image: ${php}:${v}-php-fpm
    volumes: ["./:/app"]`;
const franken = `services:
  app:
    image: ${php}:${v}-frankenphp
    ports:
      - "8080:8080"
    volumes:
      - "./:/app"
    environment:
      FRANKENPHP_CONFIG: worker ./public/index.php`;
const proxied = `services:
  app:
    image: ${php}:${v}-php-fpm-nginx
    environment:
      # the Docker network the proxy reaches the container from
      TRUSTED_PROXIES: 172.16.0.0/12`;
const cli = `docker run --rm -v "$PWD:/app" ${php}:${v} php artisan migrate --force`;
const worker = `services:
  queue:
    image: ${php}:${v}
    volumes:
      - "./:/app"
    command: php artisan queue:work`;
const hardened = `services:
  app:
    image: ${php}:${v}-php-fpm-nginx
    read_only: true
    tmpfs:
      - "/run:exec"
      # uploads and sessions land here, so size caps them
      - "/tmp:size=256m"
    cap_drop:
      - ALL
    cap_add:
      - SETUID
      - SETGID
    environment:
      PUID: 1000
    volumes:
      - "./:/app:ro"
      # the only places the app writes, owned by UID 1000 on the host
      - "./storage:/app/storage"
      - "./bootstrap/cache:/app/bootstrap/cache"`;
const hardenedSplit = `x-hardened: &hardened
  read_only: true
  cap_drop:
    - ALL
  cap_add:
    - SETUID
    - SETGID

services:
  web:
    <<: *hardened
    image: ghcr.io/mintopia/nginx:alpine
    tmpfs:
      - "/run"
    environment:
      PUID: 1000
      PHP_FPM_HOST: php
    volumes:
      - "./public:/app/public:ro"
  php:
    <<: *hardened
    image: ${php}:${v}-php-fpm
    tmpfs:
      - "/run"
      - "/tmp"
    environment:
      PUID: 1000
    volumes:
      - "./:/app"`;
const hardenedFranken = `services:
  app:
    image: ${php}:${v}-frankenphp
    read_only: true
    cap_drop:
      - ALL
    cap_add:
      - SETUID
      - SETGID
    tmpfs:
      - "/config"
      - "/tmp"
    environment:
      PUID: 1000
    volumes:
      - "./:/app"
      # certificates from automatic HTTPS; a tmpfs loses them on restart
      - "caddy-data:/data"

volumes:
  caddy-data:`;
const hardenedCli = `docker run --rm --read-only --tmpfs /tmp \\
  --cap-drop ALL --cap-add SETUID --cap-add SETGID \\
  -e PUID=1000 -v "$PWD:/app" \\
  ${php}:${v} php artisan schedule:run`;
const extensionsDockerfile = `FROM ${php}:${v}-php-fpm
RUN install-php-extensions xsl`;
const hookDockerfile = `FROM ${php}:${v}-php-fpm
COPY --chmod=755 migrate.sh /docker-entrypoint.d/50-migrate`;
const hookScript = `#!/bin/sh
set -e
run-as php /app/artisan migrate --force
exec "$@"`;
const composerBuild = `FROM ${php}:${v}-cli AS vendor
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist
COPY . .
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative

FROM ${php}:${v}-php-fpm
COPY --from=vendor /app /app`;
const pieAlpine = `FROM ${php}:${v}-php-fpm
RUN apk add --no-cache --virtual .pie-deps $PHPIZE_DEPS \\
    && pie install xdebug/xdebug \\
    && apk del .pie-deps`;
const pieTrixie = `FROM ${php}:${v}-trixie-php-fpm
RUN apt-get update \\
    && apt-get install -y --no-install-recommends $PHPIZE_DEPS unzip \\
    && pie install xdebug/xdebug \\
    && apt-get purge -y --auto-remove $PHPIZE_DEPS unzip \\
    && rm -rf /var/lib/apt/lists/*`;
const xcaddyBuild = (from, deps) => `FROM ${from} AS caddy
COPY --from=golang:1 /usr/local/go /usr/local/go
COPY --from=caddy:builder /usr/bin/xcaddy /usr/local/bin/xcaddy
COPY --from=dunglas/frankenphp:builder /usr/local/include/wtr /usr/local/include/wtr
RUN ${deps} \\
    && v=$(frankenphp build-info | awk '$2 == "github.com/dunglas/frankenphp" { print $3 }') \\
    && PATH="/usr/local/go/bin:$PATH" \\
    CGO_ENABLED=1 \\
    CGO_CFLAGS="$(php-config --includes)" \\
    CGO_LDFLAGS="$(php-config --ldflags)" \\
    XCADDY_GO_BUILD_FLAGS="-ldflags='-w -s' -tags=nobadger,nomysql,nopgx" \\
    xcaddy build --output /frankenphp \\
        --with github.com/dunglas/frankenphp@$v \\
        --with github.com/dunglas/frankenphp/caddy@$v \\
        --with github.com/dunglas/caddy-cbrotli \\
        --with github.com/dunglas/mercure/caddy \\
        --with github.com/caddy-dns/cloudflare

FROM ${from}
COPY --from=caddy /frankenphp /usr/local/bin/frankenphp`;
const xcaddyAlpine = xcaddyBuild(`${php}:${v}-frankenphp`, 'apk add --no-cache $PHPIZE_DEPS brotli-dev');
const xcaddyTrixie = xcaddyBuild(`${php}:${v}-trixie-frankenphp`, `apt-get update \\
    && apt-get install -y --no-install-recommends $PHPIZE_DEPS libbrotli-dev`);
const cloudflare = `environment:
  SERVER_NAME: app.example.com
  CADDY_GLOBAL_OPTIONS: acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  CLOUDFLARE_API_TOKEN: \${CLOUDFLARE_API_TOKEN}`;
const status = `environment:
  PHP_FPM_STATUS_PATH: /fpm-status
  PHP_FPM_PING_PATH: /fpm-ping
  NGINX_STATUS_PATH: /nginx-status
  PHP_FPM_STATUS_ALLOW: "127.0.0.1 ::1 10.0.0.0/8"`;

const dev = `services:
  app:
    image: ${php}:${v}-php-fpm-nginx
    environment:
      PHP_INI_MODE: development
      PHP_FPM_MAX_REQUESTS: 1`;
const xdebugAlpine = `FROM ${php}:${v}-php-fpm
RUN install-php-extensions xdebug`;
const xdebugTrixie = `FROM ${php}:${v}-trixie-php-fpm
RUN apt-get update \\
    && apt-get install -y --no-install-recommends $PHPIZE_DEPS \\
    && install-php-extensions xdebug \\
    && apt-get purge -y --auto-remove $PHPIZE_DEPS \\
    && rm -rf /var/lib/apt/lists/*`;
const xdebugIni = `xdebug.mode=debug
xdebug.client_host=host.docker.internal
xdebug.start_with_request=trigger`;
const iniOverride = `; /usr/local/etc/php/conf.d/50-app.ini
realpath_cache_size = 4096K`;
const reload = `environment:
  FRANKENPHP_CONFIG: |
    worker {
      file ./public/index.php
      watch ./**/*.php
    }`;

// [variable, default, what it does]. Defaults come from the image ENV and rootfs, not the README.
const common = [
  ['APP_ROOT', '<code>/app</code>', 'The app root and the container\'s working directory. The entrypoint changes into it when it exists.'],
  ['APP_PUBLIC_PATH', '<code>$APP_ROOT/public</code>', 'The directory served over HTTP. nginx and FrankenPHP serve files from it.'],
  ['HOME', '<code>/tmp</code>', 'The home directory, for tools that write config or history there, such as psysh. <code>/tmp</code> stays writable under PUID and a read-only root.'],
  ['PUID', 'unset, so root', 'User ID the processes run as. See <a href="#hardened">Non-root and read-only</a>.'],
  ['PGID', 'same as <code>PUID</code>', 'Group ID the processes run as. Only used when <code>PUID</code> is set.'],
];
const php_ = [
  ['PHP_INI_MODE', '<code>production</code>', '<code>development</code> loads <code>php.ini-development</code>, which shows errors. Any other value stops the container.'],
  ['PHP_MEMORY_LIMIT', '<code>256M</code>', '<code>memory_limit</code>.'],
  ['PHP_UPLOAD_MAX_FILESIZE', '<code>32M</code>', '<code>upload_max_filesize</code>.'],
  ['PHP_POST_MAX_SIZE', '<code>32M</code>', '<code>post_max_size</code>. The nginx images also use it as the largest request body they accept.'],
  ['PHP_MAX_EXECUTION_TIME', '<code>30</code>', '<code>max_execution_time</code>, in seconds.'],
  ['PHP_OPCACHE_VALIDATE_TIMESTAMPS', '<code>1</code>', 'Checks files for changes, so edits show up. Set <code>0</code> in production for speed. Code changes then need a restart.'],
  ['PHP_SESSION_COOKIE_HTTPONLY', 'empty, which is off', '<code>session.cookie_httponly</code>.'],
  ['PHP_SESSION_USE_STRICT_MODE', '<code>0</code>', '<code>session.use_strict_mode</code>.'],
  ['PHP_SESSION_COOKIE_SAMESITE', 'empty', '<code>session.cookie_samesite</code>. Empty sends no <code>SameSite</code> attribute.'],
];
const fpm = [
  ['PHP_FPM_PM', '<code>dynamic</code>', 'Process manager: <code>static</code>, <code>dynamic</code> or <code>ondemand</code>.'],
  ['PHP_FPM_MAX_CHILDREN', '<code>10</code>', 'Most worker processes at once.'],
  ['PHP_FPM_START_SERVERS', '<code>2</code>', 'Workers started with the pool.'],
  ['PHP_FPM_MIN_SPARE_SERVERS', '<code>1</code>', 'Idle workers kept ready.'],
  ['PHP_FPM_MAX_SPARE_SERVERS', '<code>3</code>', 'Most idle workers kept around.'],
  ['PHP_FPM_MAX_REQUESTS', '<code>500</code>', 'Requests a worker serves before it restarts. <code>0</code> never restarts it. Use <code>1</code> in development.'],
  ['PHP_FPM_REQUEST_TERMINATE_TIMEOUT', '<code>60</code>', 'Seconds before php-fpm stops a slow request.'],
  ['PHP_FPM_STATUS_PATH', 'unset, which is off', 'Path of the php-fpm status page. In the nginx images, nginx serves it. See <a href="#status">Status pages</a>.'],
  ['PHP_FPM_PING_PATH', 'unset, which is off', 'Path of the ping page, which answers <code>pong</code>. Same serving rules as the status page.'],
];
const nginx_ = [
  ['PHP_FPM_HOST', '<code>php-fpm</code> in <code>nginx</code>, <code>127.0.0.1</code> in <code>php-fpm-nginx</code>', 'Host nginx sends PHP to. Looked up again every 10 seconds, so a restarted php-fpm container is found. Lookups use the nameservers in <code>/etc/resolv.conf</code>, which ignore search domains, so use a full name on Kubernetes.'],
  ['PHP_FPM_PORT', '<code>9000</code>', 'Port php-fpm listens on.'],
  ['PHP_POST_MAX_SIZE', '<code>32M</code>', 'nginx\'s <code>client_max_body_size</code>. Also <code>post_max_size</code> in PHP.'],
  ['NGINX_STATUS_PATH', 'unset, which is off', 'Path of nginx\'s <code>stub_status</code> page.'],
  ['PHP_FPM_STATUS_ALLOW', '<code>127.0.0.1 ::1</code>', 'Space-separated addresses or CIDR ranges that can reach the status and ping paths. Everyone else gets 403.'],
];
const franken_ = [
  ['SERVER_NAME', '<code>:8080</code>', 'Address Caddy serves. Set a hostname and Caddy gets and renews its certificate. Port 80 and 443 must reach the container for that.'],
  ['FRANKENPHP_CONFIG', 'unset', 'Goes inside the <code>frankenphp</code> block, for example <code>worker ./public/index.php</code>.'],
  ['CADDY_GLOBAL_OPTIONS', 'unset', 'Goes inside the global options block.'],
  ['CADDY_EXTRA_CONFIG', 'unset', 'Top-level Caddyfile config, outside any site block.'],
  ['CADDY_SERVER_EXTRA_DIRECTIVES', 'unset', 'Directives in the site block, before PHP is served.'],
];
const proxy = [
  ['TRUSTED_PROXIES', 'unset, which trusts nothing', 'Space-separated CIDR ranges of the proxies or load balancers in front of the container. See <a href="#proxies">Behind a proxy</a>.'],
  ['CLIENT_IP_HEADER', '<code>X-Forwarded-For</code>', 'Header a trusted proxy puts the client address in.'],
];

const toc = [
  ['run', 'Run', [
    ['one-container', 'One container'],
    ['two-containers', 'nginx and php-fpm, separately'],
    ['frankenphp-setup', 'FrankenPHP'],
    ['cli-setup', 'Commands and workers'],
  ]],
  ['configure', 'Configure', [
    ['how-settings', 'How settings reach PHP'],
    ['settings', 'Settings by image'],
    ['proxies', 'Behind a proxy'],
    ['hardened', 'Non-root and read-only'],
    ['status', 'Status pages'],
    ['logs', 'Logs'],
  ]],
  ['extend', 'Extend', [
    ['hooks', 'Start-up hooks'],
    ['extensions', 'Extensions'],
    ['pie', 'PIE extensions'],
    ['composer', 'Composer'],
    ['caddy-modules', 'Caddy modules'],
  ]],
  ['develop', 'Develop', [
    ['dev-mode', 'Development mode'],
    ['xdebug', 'Xdebug'],
    ['frankenphp-reload', 'Reloading FrankenPHP workers'],
  ]],
  ['updates', 'Updates', [
    ['rebuilds', 'When images are rebuilt'],
    ['choosing-tag', 'Which tag to use'],
  ]],
  ['verify', 'Verify', [
    ['signature', 'Verify the signature'],
  ]],
] as const;
---
<Base title="Usage · mintopia/php" description="How to run, configure and extend the images, with compose files, every environment variable and Dockerfiles." current="usage">
  <div class="page usage lined" data-line={v}>
    <header class="page-head">
      <h1>Usage</h1>
      <p>Run, configure and extend the images, with a compose file or Dockerfile for each.</p>
    </header>

    <div class="docs">
      <nav class="toc" aria-label="On this page">
        <details open>
          <summary>On this page</summary>
          <script is:inline>
            { const d = document.currentScript.parentElement, m = matchMedia('(max-width: 719.98px)'), f = () => { d.open = !m.matches; }; f(); m.addEventListener('change', f); }
          </script>
          <div class="toc-list">
            {toc.map(([id, label, items]) => (
              <div>
                <a class="toc-head" href={`#${id}`}>{label}</a>
                {items.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
              </div>
            ))}
          </div>
        </details>
      </nav>

      <div class="docs-body prose">
        <h2 id="run">Run</h2>
        <p>Pick the variant that matches how your app takes requests.</p>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Which variant to use">
          <table class="shapes" aria-labelledby="run">
            <thead><tr><th scope="col">You need</th><th scope="col">Variant</th></tr></thead>
            <tbody>
              <tr><td><a href="#one-container">One container serving a PHP app over HTTP</a></td><td><code>php-fpm-nginx</code> or <code>frankenphp</code></td></tr>
              <tr><td><a href="#two-containers">Web server and PHP scaled separately</a></td><td><code>nginx</code> + <code>php-fpm</code></td></tr>
              <tr><td><a href="#frankenphp-setup">Long-running workers, HTTPS from Caddy, early hints</a></td><td><code>frankenphp</code></td></tr>
              <tr><td><a href="#cli-setup">Queues, cron, migrations, tests</a></td><td><code>cli</code></td></tr>
            </tbody>
          </table>
        </div>

        <section id="one-container">
          <h3>One container</h3>
          <p>nginx and php-fpm run side by side under s6-overlay. nginx serves static files from <code>APP_PUBLIC_PATH</code> and passes PHP requests to php-fpm on the loopback.</p>
          <figure class="route" aria-label="Browser to nginx on port 8080, then FastCGI to php-fpm inside one container">
            <div class="stop ext">Browser</div>
            <div class="hop"><span>HTTP</span></div>
            <div class="ctr">
              <span class="ctr-tag">php:{v}-php-fpm-nginx</span>
              <div class="ctr-row">
                <div class="stop">nginx<small>:8080</small></div>
                <div class="hop"><span>FastCGI 127.0.0.1:9000</span></div>
                <div class="stop php">php-fpm<small>/app</small></div>
              </div>
            </div>
          </figure>
          <Code lang="compose.yaml" code={one} />
        </section>

        <section id="two-containers">
          <h3>nginx and php-fpm, separately</h3>
          <p>The <code>nginx</code> image finds php-fpm by name through <code>PHP_FPM_HOST</code>, looking it up again every 10 seconds so php-fpm can restart or scale. nginx needs only the public files; php-fpm needs the whole app.</p>
          <figure class="route" aria-label="Browser to nginx container, then FastCGI to a separate php-fpm container">
            <div class="stop ext">Browser</div>
            <div class="hop"><span>HTTP</span></div>
            <div class="ctr">
              <span class="ctr-tag">nginx:alpine</span>
              <div class="ctr-row"><div class="stop">nginx<small>:8080</small></div></div>
            </div>
            <div class="hop"><span>FastCGI php:9000</span></div>
            <div class="ctr">
              <span class="ctr-tag">php:{v}-php-fpm</span>
              <div class="ctr-row"><div class="stop php">php-fpm<small>:9000</small></div></div>
            </div>
          </figure>
          <Code lang="compose.yaml" code={two} />
        </section>

        <section id="frankenphp-setup">
          <h3>FrankenPHP</h3>
          <p>Caddy and PHP in one process. Worker mode keeps the app booted between requests. Set <code>SERVER_NAME</code> to a hostname and Caddy gets its certificate itself.</p>
          <figure class="route" aria-label="Browser to FrankenPHP, which runs Caddy and PHP in one process">
            <div class="stop ext">Browser</div>
            <div class="hop"><span>HTTP or HTTPS</span></div>
            <div class="ctr">
              <span class="ctr-tag">php:{v}-frankenphp</span>
              <div class="ctr-row"><div class="stop php">Caddy + PHP worker<small>:8080</small></div></div>
            </div>
          </figure>
          <Code lang="compose.yaml" code={franken} />
        </section>

        <section id="cli-setup">
          <h3>Commands and workers</h3>
          <p>The <code>cli</code> image runs whatever command you give it: one-off tasks, or queue workers and schedulers alongside a web container.</p>
          <Code lang="shell" code={cli} />
          <Code lang="compose.yaml" code={worker} />
        </section>

        <h2 id="configure">Configure</h2>
        <p>Settings are environment variables. The container reads them when it starts, so set them in your compose file or <code>docker run</code> command, then restart the container.</p>

        <section id="how-settings">
          <h3>How settings reach PHP</h3>
          <p>The PHP settings in the tables below are written to <code>/usr/local/etc/php/conf.d/zz-env.ini</code> at start-up, from the environment variables. For anything else, add your own <code>.ini</code> file to the same directory, copied in your Dockerfile or mounted.</p>
          <p>PHP reads the files in that directory in name order, and <code>zz-env.ini</code> is read last. If a setting is in both, the environment variable wins. Use the variables where they exist.</p>
          <Code lang="ini" code={iniOverride} />
          <p class="muted">With <code>PHP_INI_MODE=development</code>, PHP starts from <code>php.ini-development</code> instead of <code>php.ini-production</code>. Your <code>.ini</code> files still apply.</p>
        </section>

        <section id="settings">
          <h3>Settings by image</h3>
          <p>Each image reads only some of the settings. This table shows which tables to read for each variant.</p>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Settings tables by variant">
            <table aria-labelledby="settings">
              <thead><tr><th scope="col">Variant</th><th scope="col">Listens on</th><th scope="col">Read these tables</th></tr></thead>
              <tbody>
                <tr><td><code>cli</code></td><td>nothing</td><td><a href="#paths-users">Paths and users</a>, <a href="#php">PHP</a></td></tr>
                <tr><td><code>php-fpm</code></td><td>9000</td><td><a href="#paths-users">Paths and users</a>, <a href="#php">PHP</a>, <a href="#php-fpm-settings">php-fpm</a></td></tr>
                <tr><td><code>php-fpm-nginx</code></td><td>8080, and 9000 inside the container</td><td><a href="#paths-users">Paths and users</a>, <a href="#php">PHP</a>, <a href="#php-fpm-settings">php-fpm</a>, <a href="#nginx-settings">nginx</a>, <a href="#proxy-settings">Client IP and proxies</a></td></tr>
                <tr><td><code>nginx</code></td><td>8080</td><td><a href="#paths-users">Paths and users</a>, <a href="#nginx-settings">nginx</a>, <a href="#proxy-settings">Client IP and proxies</a></td></tr>
                <tr><td><code>frankenphp</code></td><td>8080</td><td><a href="#paths-users">Paths and users</a>, <a href="#php">PHP</a>, <a href="#frankenphp-settings">FrankenPHP</a>, <a href="#proxy-settings">Client IP and proxies</a></td></tr>
              </tbody>
            </table>
          </div>

          <h4 id="paths-users">Paths and users</h4>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Paths and users variables"><table class="env">
            <thead><tr><th scope="col">Variable</th><th scope="col">Default</th><th scope="col">What it does</th></tr></thead>
            <tbody>{common.map(([n, d, w]) => <tr><td class="mono">{n}</td><td set:html={d} /><td set:html={w} /></tr>)}</tbody>
          </table></div>

          <h4 id="php">PHP</h4>
          <div class="table-wrap" tabindex="0" role="region" aria-label="PHP variables"><table class="env">
            <thead><tr><th scope="col">Variable</th><th scope="col">Default</th><th scope="col">What it does</th></tr></thead>
            <tbody>{php_.map(([n, d, w]) => <tr><td class="mono">{n}</td><td set:html={d} /><td set:html={w} /></tr>)}</tbody>
          </table></div>

          <h4 id="php-fpm-settings">php-fpm</h4>
          <p class="muted">These set the pool in <code>www.conf</code>. In the <code>php-fpm-nginx</code> image, nginx also publishes the status and ping paths.</p>
          <div class="table-wrap" tabindex="0" role="region" aria-label="php-fpm variables"><table class="env">
            <thead><tr><th scope="col">Variable</th><th scope="col">Default</th><th scope="col">What it does</th></tr></thead>
            <tbody>{fpm.map(([n, d, w]) => <tr><td class="mono">{n}</td><td set:html={d} /><td set:html={w} /></tr>)}</tbody>
          </table></div>

          <h4 id="nginx-settings">nginx</h4>
          <div class="table-wrap" tabindex="0" role="region" aria-label="nginx variables"><table class="env">
            <thead><tr><th scope="col">Variable</th><th scope="col">Default</th><th scope="col">What it does</th></tr></thead>
            <tbody>{nginx_.map(([n, d, w]) => <tr><td class="mono">{n}</td><td set:html={d} /><td set:html={w} /></tr>)}</tbody>
          </table></div>

          <h4 id="frankenphp-settings">FrankenPHP</h4>
          <div class="table-wrap" tabindex="0" role="region" aria-label="FrankenPHP variables"><table class="env">
            <thead><tr><th scope="col">Variable</th><th scope="col">Default</th><th scope="col">What it does</th></tr></thead>
            <tbody>{franken_.map(([n, d, w]) => <tr><td class="mono">{n}</td><td set:html={d} /><td set:html={w} /></tr>)}</tbody>
          </table></div>
          <p class="muted">FrankenPHP also imports any <code>*.caddyfile</code> in <code>/etc/frankenphp/Caddyfile.d/</code>.</p>

          <h4 id="proxy-settings">Client IP and proxies</h4>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Proxy variables"><table class="env">
            <thead><tr><th scope="col">Variable</th><th scope="col">Default</th><th scope="col">What it does</th></tr></thead>
            <tbody>{proxy.map(([n, d, w]) => <tr><td class="mono">{n}</td><td set:html={d} /><td set:html={w} /></tr>)}</tbody>
          </table></div>
          <p class="muted"><code>NGINX_REAL_IP_FROM</code> and <code>NGINX_REAL_IP_HEADER</code> still work as older names for these two.</p>
        </section>

        <section id="proxies">
          <h3 id="proxy-h">Behind a proxy</h3>
          <p>nginx and FrankenPHP accept <code>X-Forwarded-*</code> headers only from addresses in <code>TRUSTED_PROXIES</code>, then hand PHP the real client address and scheme. Untrusted headers never reach PHP, so your framework can trust every proxy. Switch the setting to see what PHP receives.</p>
          <div class="demo">
            <div class="seg" role="radiogroup" aria-label="TRUSTED_PROXIES">
              <label><input type="radio" name="trust" value="yes" checked />Trusted: <code>172.16.0.0/12</code></label>
              <label><input type="radio" name="trust" value="no" />Unset</label>
            </div>
            <figure class="route" aria-label="Browser to a proxy at 172.18.0.2, which forwards to the container">
              <div class="stop ext">Browser<small>203.0.113.7</small></div>
              <div class="hop"><span>HTTPS</span></div>
              <div class="stop ext">Proxy<small>172.18.0.2</small></div>
              <div class="hop"><span>HTTP, X-Forwarded-*</span></div>
              <div class="ctr">
                <span class="ctr-tag">php:{v}-php-fpm-nginx</span>
                <div class="ctr-row">
                  <div class="stop"><span class="yes">trusts 172.18.0.2</span><span class="no">trusts nothing</span><small>nginx</small></div>
                  <div class="hop"><span>FastCGI</span></div>
                  <div class="stop php">PHP</div>
                </div>
              </div>
            </figure>
            <div class="table-wrap" tabindex="0" role="region" aria-label="Proxy $_SERVER values">
              <table class="server" aria-labelledby="proxy-h">
                <thead><tr><th scope="col">$_SERVER</th><th scope="col">PHP sees</th></tr></thead>
                <tbody>
                  <tr><td class="mono">REMOTE_ADDR</td><td class="mono"><span class="yes">203.0.113.7</span><span class="no">172.18.0.2</span></td></tr>
                  <tr><td class="mono">HTTPS</td><td class="mono"><span class="yes">on</span><span class="no">(empty)</span></td></tr>
                  <tr><td class="mono">REQUEST_SCHEME</td><td class="mono"><span class="yes">https</span><span class="no">http</span></td></tr>
                  <tr><td class="mono">HTTP_X_FORWARDED_FOR</td><td class="mono"><span class="yes">203.0.113.7</span><span class="no">172.18.0.2</span></td></tr>
                  <tr><td class="mono">HTTP_X_FORWARDED_HOST</td><td class="mono"><span class="yes">passed through</span><span class="no">(empty)</span></td></tr>
                </tbody>
              </table>
            </div>
          </div>
          <Code lang="compose.yaml" code={proxied} />
          <h4>What to trust</h4>
          <div class="ranges table-wrap" tabindex="0" role="region" aria-label="Trusted proxy ranges"><Fragment set:html={proxyRanges} /></div>
          <p class="muted">With several proxies in a chain, list every hop's range. Never trust <code>0.0.0.0/0</code> in production.</p>
        </section>

        <section id="hardened">
          <h3 id="hardened-h">Non-root and read-only</h3>
          <p><code>PUID</code> sets the user ID the container's processes run as, and <code>PGID</code> sets the group. Without <code>PUID</code>, everything runs as root.</p>
          <ul>
            <li>The IDs are numbers. No user is added to <code>/etc/passwd</code>, so this works on a read-only root filesystem.</li>
            <li>The entrypoint doesn't change the owner of anything. Mounted files must already be readable, and writable where the app writes, by that ID.</li>
            <li>php-fpm's master process stays root and runs its workers as <code>PUID</code>. nginx and FrankenPHP run entirely as <code>PUID</code>.</li>
            <li>Start-up hooks run as root, before the switch. See <a href="#hooks">Start-up hooks</a>.</li>
            <li>Dropping all capabilities also drops <code>SETUID</code> and <code>SETGID</code>, which the switch needs. Add them back, as below.</li>
          </ul>
          <p>The images also work with a read-only root filesystem and no capabilities, as long as each path the variant writes to is a tmpfs.</p>
          <p>A tmpfs is an in-memory directory that starts empty on every start, so use one for scratch space. Anything that has to survive a restart, such as uploaded files or certificates, needs a volume instead. Bind mounts and volumes stay writable under <code>read_only</code>, so the app's code can be mounted <code>:ro</code> and only the directories it writes to left writable.</p>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Writable tmpfs by variant">
            <table aria-labelledby="hardened-h">
              <thead><tr><th scope="col">Variant</th><th scope="col">Writable tmpfs</th></tr></thead>
              <tbody>
                <tr><td><code>cli</code></td><td>none, or <code>/tmp</code> if the app writes temp files</td></tr>
                <tr><td><code>php-fpm</code></td><td><code>/run</code>, and <code>/tmp</code> for sessions and uploads</td></tr>
                <tr><td><code>nginx</code></td><td><code>/run</code></td></tr>
                <tr><td><code>php-fpm-nginx</code></td><td><code>/run:exec</code> for s6-overlay, and <code>/tmp</code></td></tr>
                <tr><td><code>frankenphp</code></td><td><code>/config</code>, <code>/tmp</code>, and <code>/data</code> as a tmpfs or a volume</td></tr>
              </tbody>
            </table>
          </div>
          <h4>php-fpm-nginx</h4>
          <Code lang="compose.yaml" code={hardened} />
          <h4>php-fpm and nginx in separate containers</h4>
          <Code lang="compose.yaml" code={hardenedSplit} />
          <h4>FrankenPHP</h4>
          <Code lang="compose.yaml" code={hardenedFranken} />
          <h4>CLI</h4>
          <Code lang="sh" code={hardenedCli} />
          <p class="muted">nginx renders its config into <code>/run/nginx</code>. Extra <code>*.conf</code> files mounted in <code>/etc/nginx/conf.d/</code> are still included. With FrankenPHP's automatic HTTPS, use a volume for <code>/data</code> so certificates survive restarts.</p>
        </section>

        <section id="status">
          <h3>Status pages</h3>
          <p>Off until you set a path. How the page is reached depends on the variant.</p>
          <ul>
            <li><strong>php-fpm-nginx and nginx:</strong> nginx serves each path over HTTP, but only to addresses in <code>PHP_FPM_STATUS_ALLOW</code>. Everyone else gets 403.</li>
            <li><strong>php-fpm:</strong> there is no web server, so php-fpm answers only over FastCGI, on port 9000. <code>PHP_FPM_STATUS_ALLOW</code> does nothing here. Keep port 9000 off public networks.</li>
          </ul>
          <p>With separate containers, set the same <code>PHP_FPM_STATUS_PATH</code> and <code>PHP_FPM_PING_PATH</code> on both the php-fpm and nginx containers.</p>
          <Code lang="compose.yaml" code={status} />
        </section>

        <section id="logs">
          <h3 id="logs-h">Logs</h3>
          <p>Everything goes to stdout and stderr, so <code>docker logs</code> shows it all. Nothing writes log files inside the container.</p>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Log output by variant">
            <table aria-labelledby="logs-h">
              <thead><tr><th scope="col">Variant</th><th scope="col">stdout</th><th scope="col">stderr</th></tr></thead>
              <tbody>
                <tr><td><code>cli</code></td><td>the script's output</td><td>PHP errors and warnings</td></tr>
                <tr><td><code>php-fpm</code></td><td>nothing</td><td>php-fpm's request log, its own log and PHP errors</td></tr>
                <tr><td><code>php-fpm-nginx</code></td><td>nginx's access log</td><td>nginx's error log, php-fpm's log and PHP errors</td></tr>
                <tr><td><code>nginx</code></td><td>nginx's access log</td><td>nginx's error log</td></tr>
                <tr><td><code>frankenphp</code></td><td>nothing</td><td>Caddy and FrankenPHP's JSON log, PHP errors included</td></tr>
              </tbody>
            </table>
          </div>
          <p class="muted">php-fpm prefixes PHP errors with <code>NOTICE: PHP message:</code> and cuts lines at 8192 bytes. The standalone <code>php-fpm</code> image logs each request with the client IP nginx passes on. In <code>php-fpm-nginx</code> only nginx logs requests. FrankenPHP has no access log unless you set <code>CADDY_SERVER_EXTRA_DIRECTIVES=log</code>.</p>
        </section>

        <h2 id="extend">Extend</h2>
        <p>Build your own image on top of one of these to add extensions, start-up hooks and Composer dependencies.</p>

        <section id="hooks">
          <h3>Start-up hooks</h3>
          <p>A start-up hook is a script that runs every time the container starts, before PHP, nginx or FrankenPHP does. Put executable files in <code>/docker-entrypoint.d/</code> and the entrypoint runs them in order. Use hooks for work that has to happen at start: running migrations, warming a cache, or creating directories on a mounted volume.</p>
          <div class="table-wrap" tabindex="0" role="region" aria-label="How start-up hooks run">
            <table class="steps">
              <thead><tr><th scope="col">Question</th><th scope="col">Answer</th></tr></thead>
              <tbody>
                <tr><td>When</td><td>Every time a container starts, including one-off commands run with <code>docker run</code>.</td></tr>
                <tr><td>Order</td><td>Filename order. Start names with numbers, such as <code>10-cache</code> and <code>50-migrate</code>.</td></tr>
                <tr><td>As which user</td><td>root. <code>PUID</code> applies after the last hook.</td></tr>
                <tr><td>What they see</td><td>The config is already written: nginx config, the PHP <code>.ini</code> files and the environment.</td></tr>
                <tr><td>Which images</td><td>All of them: <code>cli</code>, <code>php-fpm</code>, <code>php-fpm-nginx</code>, <code>nginx</code> and <code>frankenphp</code>.</td></tr>
                <tr><td>Rules</td><td>Executable, no spaces in the filename, and the last line must be <code>exec "$@"</code>. A hook that fails stops the container. A hook that skips <code>exec "$@"</code> stops the command from running.</td></tr>
                <tr><td>Child images</td><td>Each image can add its own. A file with the same name replaces the one from the image below.</td></tr>
              </tbody>
            </table>
          </div>
          <p>This hook runs migrations. It uses <code>run-as</code>, which runs a command as <code>PUID</code> when it is set and as root otherwise, so the migration writes files as the app's user.</p>
          <Code lang="Dockerfile" code={hookDockerfile} />
          <Code lang="sh" code={hookScript} />
          <p class="muted">Hooks run every time, so this migration also runs when you start the image for a one-off command. With several replicas, each one runs the hook at the same moment. Keep hooks safe to run more than once, or run migrations as a separate job.</p>
        </section>

        <section id="extensions">
          <h3>Extensions</h3>
          <p>Every image has <code>install-php-extensions</code>, which installs and enables PHP extensions along with the build dependencies they need. The bundled extensions in the Matrix are already in the images. Use this for the rest.</p>
          <Code lang="Dockerfile" code={extensionsDockerfile} />
        </section>

        <section id="pie">
          <h3>PIE extensions</h3>
          <p><code>pie</code> installs and enables extensions published on Packagist. The images have no compiler, so PIE needs <code>$PHPIZE_DEPS</code> installed while it runs. Install them, run PIE, then remove them in the same <code>RUN</code> so the layer stays small.</p>
          <div class="os-switch">
            <div class="seg small" role="radiogroup" aria-label="OS">
              <label><input type="radio" name="pie-os" value="alpine" checked />alpine</label>
              <label><input type="radio" name="pie-os" value="trixie" />trixie</label>
            </div>
            <div class="alpine"><Code lang="Dockerfile" code={pieAlpine} /></div>
            <div class="trixie"><Code lang="Dockerfile" code={pieTrixie} /></div>
          </div>
          <p class="muted">For extensions that aren't on Packagist, <code>install-php-extensions</code> handles its own build dependencies, as in <a href="#extensions">Extensions</a>.</p>
        </section>

        <section id="composer">
          <h3>Composer</h3>
          <p>Composer isn't in the images, because an app doesn't need it to run. Install dependencies in a build stage, then copy only the app and <code>vendor/</code> into the final image.</p>
          <p>The build stage uses the <code>cli</code> image of the same PHP version and OS. It has the same extensions as the image you deploy, so <code>composer install</code> checks your <code>ext-*</code> requirements against the real ones.</p>
          <Code lang="Dockerfile" code={composerBuild} />
          <p class="muted">On trixie, also install <code>unzip</code> in the build stage. Composer needs it to unpack packages.</p>
        </section>

        <section id="caddy-modules">
          <h3>Caddy modules</h3>
          <p>To add Caddy modules to FrankenPHP, rebuild its binary with <code>xcaddy</code> in a build stage on top of the image, then copy it into the final image. Building on the image links against its own PHP. This adds the Cloudflare DNS module, so Caddy can get certificates with the ACME DNS challenge, including wildcards and hosts not reachable from the internet.</p>
          <div class="os-switch">
            <div class="seg small" role="radiogroup" aria-label="OS">
              <label><input type="radio" name="caddy-os" value="alpine" checked />alpine</label>
              <label><input type="radio" name="caddy-os" value="trixie" />trixie</label>
            </div>
            <div class="alpine"><Code lang="Dockerfile" code={xcaddyAlpine} /></div>
            <div class="trixie"><Code lang="Dockerfile" code={xcaddyTrixie} /></div>
          </div>
          <p>The build matches the FrankenPHP version already in the image and keeps its brotli and Mercure modules. Add more modules with extra <code>--with</code> lines. Turn the module on with <code>CADDY_GLOBAL_OPTIONS</code>, with a Cloudflare API token that can edit DNS for the zone:</p>
          <Code lang="compose.yaml" code={cloudflare} />
        </section>

        <h2 id="develop">Develop</h2>
        <p>The same images work for local development, with a few settings changed.</p>

        <section id="dev-mode">
          <h3>Development mode</h3>
          <p><code>PHP_INI_MODE=development</code> loads <code>php.ini-development</code>, which displays errors. Leave <code>PHP_OPCACHE_VALIDATE_TIMESTAMPS</code> at <code>1</code> so code changes are picked up. <code>PHP_FPM_MAX_REQUESTS=1</code> restarts each php-fpm worker after every request, so no state leaks between requests.</p>
          <Code lang="compose.yaml" code={dev} />
          <p class="muted">FrankenPHP has no per-worker request limit. Skip worker mode in development, or let the app restart its worker: Laravel Octane takes <code>--max-requests=1</code>, and the Symfony runtime reads <code>FRANKENPHP_LOOP_MAX=1</code>.</p>
        </section>

        <section id="xdebug">
          <h3>Xdebug</h3>
          <p>Install it in a derived image. On trixie there is no compiler, so add <code>$PHPIZE_DEPS</code> and purge it in the same <code>RUN</code>.</p>
          <div class="os-switch">
            <div class="seg small" role="radiogroup" aria-label="OS">
              <label><input type="radio" name="xdebug-os" value="alpine" checked />alpine</label>
              <label><input type="radio" name="xdebug-os" value="trixie" />trixie</label>
            </div>
            <div class="alpine"><Code lang="Dockerfile" code={xdebugAlpine} /></div>
            <div class="trixie"><Code lang="Dockerfile" code={xdebugTrixie} /></div>
          </div>
          <p>Configure it with an <code>.ini</code> file in <code>/usr/local/etc/php/conf.d/</code>, copied in or mounted. See <a href="#how-settings">How settings reach PHP</a>.</p>
          <Code lang="xdebug.ini" code={xdebugIni} />
          <p class="muted">On Linux, <code>host.docker.internal</code> needs <code>--add-host=host.docker.internal:host-gateway</code>. Xdebug has no PHP 8.6 release yet.</p>
        </section>

        <section id="frankenphp-reload">
          <h3>Reloading FrankenPHP workers</h3>
          <p>FrankenPHP restarts worker scripts when files they watch change. Spread the worker block over several lines.</p>
          <Code lang="compose.yaml" code={reload} />
        </section>

        <h2 id="updates">Updates</h2>
        <p>Tags move. Pick one by how much change you want to take on without asking.</p>

        <section id="rebuilds">
          <h3>When images are rebuilt</h3>
          <p>A check runs every day and rebuilds each image on its own. An image is rebuilt when:</p>
          <ul>
            <li>PHP releases a new patch. It is published under its own tag, such as <code>{v}.13</code>, and the <code>{v}</code> tags move to it.</li>
            <li>Something it is built from has a new version: the OS base image, nginx, FrankenPHP, s6-overlay or a bundled extension.</li>
            <li>Its OS packages have a CVE that has a fix available.</li>
            <li>It was last built more than 30 days ago.</li>
            <li>This repository changes how the images are built.</li>
          </ul>
          <p>Every rebuild also upgrades the OS packages. Images with nothing to change keep their digest, so a quiet tag can go a month without moving.</p>
          <p>Older patch tags keep being rebuilt the same way. After <code>{v}.13</code> ships, <code>{v}.12</code> still gets OS and extension fixes, built from the same PHP source. Its PHP version never changes. This lasts while its minor version is still built here. Release candidates, such as <code>8.6-rc1</code>, stop once the next one ships.</p>
          <p>Each image page lists its builds and what changed in each, and the <a href="/changelog/">changelog</a> lists them all.</p>
        </section>

        <section id="choosing-tag">
          <h3 id="choosing-tag-h">Which tag to use</h3>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Tags by how often they move">
            <table class="tags" aria-labelledby="choosing-tag-h">
              <thead><tr><th scope="col">Tag</th><th scope="col">Example</th><th scope="col">Moves when</th></tr></thead>
              <tbody>
                <tr><td>Minor</td><td><code>{v}-php-fpm</code></td><td>Any rebuild, including new PHP patches. Most people want this one.</td></tr>
                <tr><td>Patch</td><td><code>{v}.12-php-fpm</code></td><td>Any rebuild, but PHP stays at {v}.12. Move up to the next patch yourself.</td></tr>
                <tr><td>Digest</td><td><code>{v}-php-fpm@sha256:…</code></td><td>Never. You get the same image every time, fixes included only when you change the digest.</td></tr>
                <tr><td>Floating</td><td><code>latest</code>, <code>8</code>, <code>unstable</code></td><td>Can jump to a new minor version. Fine for trying things out, not for production.</td></tr>
              </tbody>
            </table>
          </div>
          <p>For production, pin a digest and let Renovate or Dependabot open a pull request when the tag behind it moves. You get every fix, and each change goes through your own tests first. Image pages show each tag's current digest.</p>
        </section>

        <h2 id="verify">Verify</h2>
        <p>This repository's GitHub Actions workflow signs every image with keyless cosign.</p>

        <section id="signature">
          <h3>Verify the signature</h3>
          <p>Check a tag before you pull or deploy it. The same command works for <code>ghcr.io/mintopia/nginx</code>.</p>
          <Code lang="shell" code={verify} />
          <p class="muted">The signature is on the multi-arch index, so verify a tag or the index digest, not a single architecture's digest.</p>
        </section>
      </div>
    </div>
  </div>
</Base>

