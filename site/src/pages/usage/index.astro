  ['frameworks', 'Frameworks', [
    ['app-roles', 'One image, many roles'],
    ['stopping', 'Stopping cleanly'],
    ['laravel', 'Laravel'],
    ['symfony', 'Symfony'],
  ]],
  ['develop', 'Develop', [
    ['dev-mode', 'Development mode'],
    ['xdebug', 'Xdebug'],
