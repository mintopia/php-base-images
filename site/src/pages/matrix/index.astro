---
import Base from '../../layouts/Base.astro';
import Bullet from '../../components/Bullet.astro';
import { images, versions, versionKeys, extensions, extensionVersion, builtInModules, VARIANTS, OSES } from '../../lib/data';

const dropped = versionKeys.flatMap((v) => Object.entries(versions[v].dropped ?? {}).map(([ext, why]) => ({ v, ext, why })));
const built = (v: string, os: string, variant: string) => images.some((i) => i.version === v && i.os === os && i.variant === variant);
---
<Base title="Feature matrix · mintopia/php" description="Extensions, variants and tools in every PHP image, by PHP version." current="matrix">
  <div class="page">
    <header class="page-head">
      <h1>Feature matrix</h1>
      <p>What every image carries, by PHP line. Versions come from the labels on the current images; a dot is an extension bundled with PHP itself.</p>
    </header>

    <section>
      <h2>Added extensions</h2>
      <div class="table-wrap">
        <table class="grid">
          <thead><tr><th>Extension</th>{versionKeys.map((v) => <th><Bullet version={v} size="sm" /></th>)}</tr></thead>
          <tbody>
            {extensions.map((ext) => (
              <tr>
                <th scope="row" class="mono">{ext}</th>
                {versionKeys.map((v) => {
                  const why = versions[v].dropped?.[ext];
                  if (why) return <td class="off" title={why}><span class="struck">not built</span><sup>†</sup></td>;
                  if (!versions[v].extensions.includes(ext)) return <td class="muted">—</td>;
                  const ver = extensionVersion(v, ext);
                  return <td class="on" data-line={v}>{ver ? <span class="mono">{ver}</span> : <span class="dot" aria-label="bundled" />}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {dropped.length > 0 && (
        <ul class="notes">
          {dropped.map((d) => <li>† <strong>{d.ext}</strong> on PHP {d.v}: {d.why}.</li>)}
        </ul>
      )}
    </section>

    <section>
      <h2>Built into PHP</h2>
      {builtInModules.length === 0 ? (
        <p class="notes">The full module list appears once builds have recorded <code>php -m</code>.</p>
      ) : (
        <>
          <p class="notes lead">Every module compiled into PHP itself, read from <code>php -m</code> on the current cli images.</p>
          <div class="table-wrap">
            <table class="grid">
              <thead><tr><th>Module</th>{versionKeys.map((v) => <th><Bullet version={v} size="sm" /></th>)}</tr></thead>
              <tbody>
                {builtInModules.map(([m, byVersion]) => (
                  <tr>
                    <th scope="row" class="mono">{m}</th>
                    {versionKeys.map((v) => {
                      const oses = byVersion.get(v) ?? [];
                      if (oses.length === 0) return <td class="muted">—</td>;
                      return <td class="on" data-line={v}>{oses.length === OSES.length ? <span class="dot" aria-label="built in" /> : <span class="os-only">{oses.join(', ')} only</span>}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
    </section>

    <section>
      <h2>Variants</h2>
      <div class="table-wrap">
        <table class="grid">
          <thead><tr><th>Variant</th><th>OS</th>{versionKeys.map((v) => <th><Bullet version={v} size="sm" /></th>)}</tr></thead>
          <tbody>
            {VARIANTS.flatMap((t) => OSES.map((os, i) => (
              <tr>
                {i === 0 && <th scope="row" rowspan={OSES.length} class="mono">{t}</th>}
                <td>{os}</td>
                {versionKeys.map((v) => built(v, os, t)
                  ? <td class="on" data-line={v}><span class="dot" aria-label="built" /></td>
                  : <td class="off"><span class="struck">not built</span></td>)}
              </tr>
            )))}
          </tbody>
        </table>
      </div>
      <p class="notes">The <code>nginx</code> image (<code>ghcr.io/mintopia/nginx</code>) is built for alpine and trixie and pairs with <code>php-fpm</code>.</p>
    </section>

    <section class="two">
      <div>
        <h2>Every image</h2>
        <dl class="facts">
          <div><dt>Architectures</dt><dd>amd64, arm64</dd></div>
          <div><dt>PHP build</dt><dd>ZTS, compiled from php-src tags</dd></div>
          <div><dt>Configuration</dt><dd><code>php.ini-production</code>, <code>expose_php</code> off</dd></div>
          <div><dt>Signing</dt><dd>cosign keyless</dd></div>
          <div><dt>Users</dt><dd>root by default, <code>PUID</code> / <code>PGID</code> to drop</dd></div>
        </dl>
      </div>
      <div>
        <h2>Tools</h2>
        <dl class="facts">
          <div><dt>PIE</dt><dd>included</dd></div>
          <div><dt>install-php-extensions</dt><dd>included</dd></div>
          <div><dt>Composer</dt><dd class="muted">not included</dd></div>
        </dl>
      </div>
    </section>
  </div>
</Base>

<style>
  section + section { margin-top: 56px; }
  .grid { width: auto; min-width: 100%; }
  .grid th[scope='row'] { font-weight: 500; font-size: 13px; color: var(--ink); border-bottom: 1px solid var(--rule); padding: 12px 24px 12px 0; text-align: left; white-space: nowrap; }
  .grid thead th { padding-right: 24px; }
  .grid td { padding-right: 24px; white-space: nowrap; }
  .on .mono { font-size: 13px; border-bottom: 2px solid var(--line); padding-bottom: 1px; }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
  .off { color: var(--muted); font-size: 13px; }
  .os-only { font-size: 12px; color: var(--muted); }
  .notes.lead { margin: 0 0 16px; }
  .struck { text-decoration: line-through; text-decoration-color: var(--muted); }
  .notes { list-style: none; margin-top: 16px; font-size: 13px; color: var(--muted); }
  .notes li + li { margin-top: 4px; }
  .notes strong { color: var(--ink); font-weight: 500; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 48px; }
  .facts > div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--rule); font-size: 14px; }
  .facts dt { color: var(--muted); }
  .facts dd { text-align: right; }
</style>
