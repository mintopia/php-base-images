---
import Base from '../layouts/Base.astro';
import Bullet from '../components/Bullet.astro';
import Copy from '../components/Copy.astro';
import { images, versions, versionKeys, latestStable, extensions, ARCHES, imagePath } from '../lib/data';

const base = import.meta.env.BASE_URL;
const cli = (v: string) => images.find((i) => i.version === v && i.os === 'alpine' && i.variant === 'cli');
const alias = (v: string) => (v === latestStable ? 'latest' : versions[v].stable ? v : 'unstable');
---
<Base title="mintopia/php · PHP base images" description="Multi-arch PHP base images for Alpine and Debian trixie, built from php-src tags." current="home">
  <script is:inline define:vars={{ latestStable }}>
    const q = new URLSearchParams(location.search);
    if (q.has('v') || q.has('variant')) {
      const [v, os, variant] = [q.get('v') || latestStable, q.get('os') || 'alpine', q.get('variant') || 'cli'];
      location.replace(`${location.pathname}images/${variant === 'nginx' ? `nginx-${os}` : `${v}-${os}-${variant}`}/`);
    }
  </script>

  <section class="start lined" id="start" data-line={latestStable}>
    <h1>PHP base images</h1>
    <p class="lede">PHP {versionKeys[0]} to {versionKeys.at(-1)} RC for Alpine and Debian trixie, on amd64 and arm64. Built from php-src.</p>
    <fieldset class="lines">
      <legend>PHP</legend>
      {versionKeys.map((v) => (
        <label class="line-pick" title={versions[v].stable ? `PHP ${v}` : `PHP ${v} release candidate`}>
          <input type="radio" name="v" value={v} checked={v === latestStable} />
          <Bullet version={v} />
        </label>
      ))}
    </fieldset>
    {versionKeys.map((v) => {
      const ref = `ghcr.io/mintopia/php:${alias(v)}`;
      const php = cli(v)?.current?.php;
      return (
        <div class="ref" data-for={v} hidden={v !== latestStable}>
          <code class="ref-tag">ghcr.io/<wbr />mintopia/<wbr />php:<wbr /><span data-flap>{alias(v)}</span></code>
          <Copy text={ref} label="Copy reference" primary />
          <p class="ref-meta">
            {php ? <span class="mono">PHP <span data-flap>{php}</span></span> : <span>PHP {v}</span>}
            <span>alpine · cli · {ARCHES.join(' + ')}</span>
            {!versions[v].stable && <span>Release candidate, best effort</span>}
            {cli(v) && <a href={imagePath(cli(v)!)}>Choose OS and variant</a>}
          </p>
        </div>
      );
    })}
  </section>

  <section class="page offer" aria-label="What's on offer">
    <dl class="spec">
      <div><dt>Variants</dt><dd>cli · php-fpm · php-fpm-nginx · frankenphp, plus a separate nginx image</dd></div>
      <div><dt>OS</dt><dd>Alpine (default) or Debian trixie</dd></div>
      <div><dt>Extensions</dt><dd>{extensions.length} built in, with <code>pie</code> to add more. <a href={`${base}matrix/`}>See which</a></dd></div>
    </dl>
    <nav class="next" aria-label="Next">
      <a class="btn" href={`${base}images/`}>Choose an image</a>
      <a href={`${base}usage/`}>Usage guide</a>
    </nav>
  </section>
</Base>

<style>
  .start { display: flex; flex-direction: column; justify-content: center; min-height: min(72svh, 720px); background: var(--board); padding: 64px var(--gutter); border-bottom: 1px solid var(--rule); }
  .start h1 { font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1; letter-spacing: -0.03em; font-weight: 700; }
  .lede { margin: 16px 0 48px; font-size: 1.125rem; color: var(--muted); text-wrap: pretty; }
  .lines { border: 0; display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .lines legend { font-size: 0.75rem; font-weight: 500; color: var(--muted); margin-bottom: 8px; }
  .line-pick { cursor: pointer; }
  .line-pick input { position: absolute; opacity: 0; }

  .ref { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px 24px; align-items: center; }
  .ref-tag { font: 500 clamp(1.5rem, 4.2vw, 3.25rem)/1.05 var(--mono); letter-spacing: -0.03em; }
  .ref :global(.btn) { height: 44px; }
  .ref-meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 0.8125rem; color: var(--muted); }
  .ref-meta .mono { color: var(--ink); }
  .ref-meta a { color: var(--accent-text); }
  .ref[hidden] { display: none; }

  .offer { padding-top: 32px; }
  .spec > div { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 24px; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .spec dt { color: var(--muted); }
  .spec code { font-size: 0.8125rem; }
  .next { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 36px; font-size: 0.875rem; font-weight: 500; }
  .next .btn { text-decoration: none; }


  @media (max-width: 720px) {
    .spec > div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  }
  @media (max-width: 560px) {
    .ref { grid-template-columns: minmax(0, 1fr); }
    .ref :global(.btn) { justify-self: start; }
  }
</style>

<script>
  // split-flap roll: each cell steps through its alphabet to the target, left cells settling first
  const DIGITS = '0123456789';
  const LETTERS = 'abcdefghijklmnopqrstuvwxyz';
  const rolling = new WeakMap<HTMLElement, symbol>();
  const roll = (el: HTMLElement) => {
    const target = el.dataset.flap ||= el.textContent!;
    const token = Symbol();
    rolling.set(el, token);
    const cells = [...target].map((ch, i) => {
      const set = DIGITS.includes(ch) ? DIGITS : LETTERS.includes(ch) ? LETTERS : '';
      return { ch, set, at: set.indexOf(ch), steps: set ? 3 + i : 0 };
    });
    const total = Math.max(...cells.map((c) => c.steps));
    let n = 0;
    const tick = () => {
      if (rolling.get(el) !== token) return;
      el.textContent = cells.map((c) => {
        const left = c.steps - n;
        return left > 0 ? c.set[(c.at - left + c.set.length * 4) % c.set.length] : c.ch;
      }).join('');
      if (n++ < total) setTimeout(tick, 38);
    };
    tick();
  };

  const start = document.getElementById('start')!;
  start.addEventListener('change', (e) => {
    const v = (e.target as HTMLInputElement).value;
    start.dataset.line = v;
    start.querySelectorAll<HTMLElement>('.ref').forEach((r) => {
      r.hidden = r.dataset.for !== v;
      if (!r.hidden && !matchMedia('(prefers-reduced-motion: reduce)').matches) r.querySelectorAll<HTMLElement>('[data-flap]').forEach(roll);
    });
  });
</script>
