---
import Base from '../../layouts/Base.astro';
import Code from '../../components/Code.astro';
import { latestStable, versions } from '../../lib/data';

const v = latestStable;
const php = 'ghcr.io/mintopia/php';
const base = import.meta.env.BASE_URL;
const hasRedis = versions[v].extensions.includes('redis');

const laravelDockerfile = `FROM ${php}:${v}-frankenphp AS build
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY . .
# every request that isn't a file goes to public/index.php, so that becomes Octane's worker
RUN composer dump-autoload --no-dev --classmap-authoritative --no-interaction \\
    && cp vendor/laravel/octane/src/Commands/stubs/frankenphp-worker.php public/index.php \\
    && php artisan package:discover --ansi \\
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache

FROM ${php}:${v}-frankenphp
ENV PUID=10001 PGID=10001 \\
    OCTANE_SERVER=frankenphp \\
    PHP_OPCACHE_VALIDATE_TIMESTAMPS=0 \\
    FRANKENPHP_CONFIG="worker /app/public/index.php"
COPY --from=build /app /app
COPY --chmod=755 docker/20-optimize /docker-entrypoint.d/20-optimize
RUN chown -R 10001:10001 storage bootstrap/cache`;
const laravelHook = `#!/bin/sh
set -e
# a tmpfs over storage/ starts empty
run-as mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs
run-as php artisan optimize
exec "$@"`;
const laravelIgnore = `.git
.env
vendor
node_modules
storage/logs/*
storage/framework/*/*
bootstrap/cache/*.php`;
const laravelCompose = `x-app: &app
  build: .
  image: my-app
  restart: unless-stopped
  environment: &env
    APP_KEY: \${APP_KEY}
    APP_ENV: production
    APP_URL: https://app.example.com
    LOG_CHANNEL: stderr
    DB_CONNECTION: pgsql
    DB_HOST: postgres
    DB_DATABASE: app
    DB_USERNAME: app
    DB_PASSWORD: \${DB_PASSWORD}
    REDIS_CLIENT: ${hasRedis ? 'phpredis' : 'predis'}
    REDIS_HOST: redis
    QUEUE_CONNECTION: redis
    CACHE_STORE: redis
    SESSION_DRIVER: redis
    BROADCAST_CONNECTION: reverb
    REVERB_APP_ID: \${REVERB_APP_ID}
    REVERB_APP_KEY: \${REVERB_APP_KEY}
    REVERB_APP_SECRET: \${REVERB_APP_SECRET}
    REVERB_HOST: reverb
    REVERB_PORT: "8080"
    REVERB_SCHEME: http
  depends_on:
    migrate:
      condition: service_completed_successfully
  # the image's health check probes Caddy, which only the web role runs
  healthcheck:
    disable: true

services:
  app:
    <<: *app
    stop_grace_period: 30s
    ports:
      - "8080:8080"
    environment:
      <<: *env
      TRUSTED_PROXIES: 172.16.0.0/12
      MAX_REQUESTS: "1000"
      # without num, FrankenPHP starts 2 workers per host CPU, ignoring container CPU limits
      FRANKENPHP_CONFIG: |
        worker {
          file /app/public/index.php
          num 4
        }
    healthcheck: {}

  migrate:
    <<: *app
    command: php artisan migrate --force
    restart: "no"
    depends_on:
      postgres:
        condition: service_healthy

  queue:
    <<: *app
    command: php artisan queue:work --tries=3 --max-time=3600
    stop_grace_period: 70s

  scheduler:
    <<: *app
    command: php artisan schedule:work
    stop_grace_period: 10s

  reverb:
    <<: *app
    command: php artisan reverb:start --host=0.0.0.0 --port=8080
    stop_grace_period: 30s

  redis:
    image: redis:7-alpine

  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: app
      POSTGRES_PASSWORD: \${DB_PASSWORD}
    volumes:
      - "postgres:/var/lib/postgresql/data"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app"]
      interval: 2s
      retries: 30

volumes:
  postgres:`;
const horizon = `  horizon:
    <<: *app
    command: php artisan horizon
    # longer than the longest supervisor timeout in config/horizon.php
    stop_grace_period: 70s`;
const predis = `composer require predis/predis`;
const fpmWorker = `  queue:
    <<: *app
    entrypoint: ["docker-entrypoint.sh"]
    command: php artisan queue:work --tries=3 --max-time=3600
    stop_grace_period: 70s`;
const laravelHardened = `x-hardened: &hardened
  read_only: true
  cap_drop:
    - ALL
  cap_add:
    - SETUID
    - SETGID
  security_opt:
    - "no-new-privileges:true"
  tmpfs:
    - "/tmp"
    - "/app/storage:uid=10001,gid=10001"
    - "/app/bootstrap/cache:uid=10001,gid=10001"

services:
  app:
    <<: *hardened
    tmpfs:
      - "/tmp"
      - "/config"
      - "/data"
      - "/app/storage:uid=10001,gid=10001"
      - "/app/bootstrap/cache:uid=10001,gid=10001"
  migrate: *hardened
  queue: *hardened
  scheduler: *hardened
  reverb: *hardened`;
const workerRestart = `docker compose exec app curl -fsS -X POST http://localhost:2019/frankenphp/workers/restart`;
const trustHosts = `->withMiddleware(function (Middleware $middleware) {
    $middleware->trustHosts(at: ['app.example.com']);
})`;

const symfonyDockerfile = `FROM ${php}:${v}-frankenphp AS build
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
ENV APP_ENV=prod COMPOSER_ALLOW_SUPERUSER=1
WORKDIR /app
COPY composer.json composer.lock symfony.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY . .
RUN composer dump-autoload --no-dev --classmap-authoritative --no-interaction \\
    && php bin/console cache:warmup \\
    && chmod -R a+rwX var

FROM ${php}:${v}-frankenphp
ENV PUID=10001 PGID=10001 \\
    APP_ENV=prod \\
    PHP_OPCACHE_VALIDATE_TIMESTAMPS=0 \\
    FRANKENPHP_CONFIG="worker /app/public/index.php"
COPY --from=build /app /app`;
const symfonyIgnore = `.git
.env.local*
vendor
var`;
const symfonyCompose = `x-app: &app
  build: .
  image: my-app
  restart: unless-stopped
  stop_grace_period: 30s
  environment: &env
    APP_SECRET: \${APP_SECRET}
    DATABASE_URL: postgresql://app:\${DB_PASSWORD}@postgres:5432/app?serverVersion=17&charset=utf8
  depends_on:
    migrate:
      condition: service_completed_successfully
  # the image's health check probes Caddy, which only the web role runs
  healthcheck:
    disable: true

services:
  app:
    <<: *app
    ports:
      - "8080:8080"
    environment:
      <<: *env
      TRUSTED_PROXIES: 172.16.0.0/12
      FRANKENPHP_CONFIG: |
        worker {
          file /app/public/index.php
          num 4
        }
    healthcheck: {}

  migrate:
    <<: *app
    command: php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration
    restart: "no"
    depends_on:
      postgres:
        condition: service_healthy

  worker:
    <<: *app
    command: php bin/console messenger:consume async --time-limit=3600 --memory-limit=128M

  scheduler:
    <<: *app
    command: php bin/console messenger:consume scheduler_default --time-limit=3600 --memory-limit=128M

  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: app
      POSTGRES_PASSWORD: \${DB_PASSWORD}
    volumes:
      - "postgres:/var/lib/postgresql/data"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app"]
      interval: 2s
      retries: 30

volumes:
  postgres:`;
const symfonyHardened = `x-hardened: &hardened
  read_only: true
  cap_drop:
    - ALL
  cap_add:
    - SETUID
    - SETGID
  security_opt:
    - "no-new-privileges:true"
  tmpfs:
    - "/tmp"
    # cache.app pools and the Scheduler's checkpoint
    - "/app/var/share"

services:
  app:
    <<: *hardened
    tmpfs:
      - "/tmp"
      - "/app/var/share"
      - "/config"
      - "/data"
  migrate: *hardened
  worker: *hardened
  scheduler: *hardened`;

const stops = [
  ['Web (FrankenPHP)', '<code>30s</code>', 'Caddy finishes in-flight requests, then exits.'],
  ['Laravel <code>queue:work</code>', 'longest job <code>--timeout</code> plus a margin', 'The current job finishes, then the worker exits.'],
  ['Laravel Horizon', 'longest supervisor <code>timeout</code> plus a margin', 'Horizon stops its workers the same way. No <code>horizon:terminate</code> needed.'],
  ['Laravel <code>schedule:work</code>', '<code>10s</code>', 'A task still running is stopped with the container. Queue long work instead.'],
  ['Laravel Reverb', '<code>30s</code>', 'Closes open connections; clients reconnect to the next container.'],
  ['Symfony <code>messenger:consume</code>', 'longest handler plus a margin', 'The current message finishes and is acknowledged.'],
];

const toc = [
  ['shared', 'Every framework', [
    ['one-image', 'One image, many roles'],
    ['migrations', 'Migrations'],
    ['stopping', 'Stopping cleanly'],
    ['workers', 'Worker threads'],
    ['framework-proxies', 'Proxies'],
  ]],
  ['laravel', 'Laravel', [
    ['octane', 'Octane on FrankenPHP'],
    ['laravel-compose', 'Web, queue, scheduler, Reverb'],
    ['horizon', 'Horizon'],
    ['laravel-reload', 'Reloading and tuning'],
    ['laravel-hardened', 'Read-only'],
  ]],
  ['symfony', 'Symfony', [
    ['symfony-worker', 'Worker mode'],
    ['symfony-compose', 'Web, Messenger, Scheduler'],
    ['symfony-hardened', 'Read-only'],
  ]],
] as const;
---
<Base title="Frameworks · mintopia/php" description="Run Laravel and Symfony on the images: FrankenPHP worker mode, Octane, queues, Horizon, schedulers, Reverb, Messenger and migrations." current="frameworks">
  <div class="page frameworks lined" data-line={v}>
    <header class="page-head">
      <h1>Frameworks</h1>
      <p>Laravel and Symfony on the images, with every recipe here run against the published images before it was written down.</p>
    </header>

    <div class="docs">
      <nav class="toc" aria-label="On this page">
        <details open>
          <summary>On this page</summary>
          <script is:inline>
            { const d = document.currentScript.parentElement, m = matchMedia('(max-width: 719.98px)'), f = () => { d.open = !m.matches; }; f(); m.addEventListener('change', f); }
          </script>
          <div class="toc-list">
            {toc.map(([id, label, items]) => (
              <div>
                <a class="toc-head" href={`#${id}`}>{label}</a>
                {items.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
              </div>
            ))}
          </div>
        </details>
      </nav>

      <div class="docs-body prose">
        <h2 id="shared">Every framework</h2>
        <p>The same rules apply whichever framework you use.</p>

        <section id="one-image">
          <h3>One image, many roles</h3>
          <p>Build one image for the app. The web container runs it as it is. Queue workers, schedulers and one-off jobs run the same image with a different <code>command</code>. Every role then goes through the image's entrypoint, so they all get <code>PUID</code>, the PHP settings and any <a href={`${base}usage/#hooks`}>start-up hooks</a>. On <code>php-fpm-nginx</code>, those roles also need <code>entrypoint: ["docker-entrypoint.sh"]</code>, as shown under <a href="#octane">Laravel</a>.</p>
          <p><strong>Keep the web container's start command.</strong> Don't replace its <code>ENTRYPOINT</code> or <code>CMD</code>, and don't set <code>USER</code>. That includes <code>php artisan octane:frankenphp</code>, the command the Octane docs suggest. It starts its own Caddy with its own Caddyfile, so <code>TRUSTED_PROXIES</code>, the <code>HTTPS</code> handling behind a proxy, <code>PUID</code> and the start-up hooks are all lost. Use <code>FRANKENPHP_CONFIG</code> instead, as below.</p>
          <ul>
            <li>Install Composer dependencies in a build stage on the same image. See <a href={`${base}usage/#composer`}>Composer</a>.</li>
            <li>Bake the code into the image, owned by root. Only the directories the app writes to need to belong to <code>PUID</code>.</li>
            <li>Set <code>PHP_OPCACHE_VALIDATE_TIMESTAMPS=0</code>. The code never changes inside a running container.</li>
            <li>Send logs to stderr, and keep sessions, cache and queues in Redis or the database, so containers stay disposable.</li>
          </ul>
        </section>

        <section id="migrations">
          <h3>Migrations</h3>
          <p>Run migrations as a one-off <code>migrate</code> service that the other roles wait for with <code>condition: service_completed_successfully</code>. It runs once per deploy, and if it fails, nothing new starts. A start-up hook would run them in every container and every replica at the same time.</p>
        </section>

        <section id="stopping">
          <h3>Stopping cleanly</h3>
          <p>Docker sends <code>SIGTERM</code>, waits for the grace period, then kills the container. The framework commands and FrankenPHP all handle <code>SIGTERM</code> and exit with 0 once their current work is done, and they run as PID 1, so <code>init: true</code> makes no difference. What matters is the grace period: set <code>stop_grace_period</code> on every role. Don't rely on the default: on Docker Desktop it killed in-flight work after about 3 seconds.</p>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Grace period by role">
            <table class="env">
              <thead><tr><th scope="col">Role</th><th scope="col"><code>stop_grace_period</code></th><th scope="col">On SIGTERM</th></tr></thead>
              <tbody>
                {stops.map(([role, grace, what]) => (
                  <tr><td set:html={role} /><td set:html={grace} /><td set:html={what} /></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="muted">The <code>frankenphp</code> image has a health check against Caddy's admin API. Roles that don't run Caddy would show as unhealthy, so the compose files below turn it off for them with <code>healthcheck: {'{ disable: true }'}</code>.</p>
        </section>

        <section id="workers">
          <h3>Worker threads</h3>
          <p>In worker mode, each worker thread keeps a booted copy of the app in memory. <code>worker /app/public/index.php</code> on one line starts two per CPU on the host, ignoring the container's CPU limit. Set <code>num</code> with the multi-line form instead. A YAML block scalar keeps the newlines:</p>
          <Code lang="compose.yaml" code={`environment:
  FRANKENPHP_CONFIG: |
    worker {
      file /app/public/index.php
      num 4
    }`} />
        </section>

        <section id="framework-proxies">
          <h3>Proxies</h3>
          <p>With <code>TRUSTED_PROXIES</code> set, the web server gives PHP the real client address and sets <code>HTTPS</code> for requests that reached the proxy over HTTPS. Laravel and Symfony read those directly, so leave their own trusted-proxy settings alone: <code>request()-&gt;isSecure()</code>, <code>ip()</code>, <code>getClientIp()</code> and generated URLs are already right. See <a href={`${base}usage/#proxies`}>Behind a proxy</a> for the ranges to trust.</p>
          <p>The <code>Host</code> header is still whatever the client sent, and absolute URLs are built from it. Have the proxy pass <code>Host</code> through, and limit it to your own hostnames: <code>trustHosts</code> in Laravel, <code>framework.trusted_hosts</code> in Symfony.</p>
          <Code lang="bootstrap/app.php" code={trustHosts} />
        </section>

        <h2 id="laravel">Laravel</h2>
        <p>Tested with Laravel 13, Octane 2, Horizon 5 and Reverb 1.</p>

        <section id="octane">
          <h3>Octane on FrankenPHP</h3>
          <p>The image's Caddyfile already sends every request that isn't a static file to <code>public/index.php</code>. The build swaps that file for Octane's FrankenPHP worker script, and <code>FRANKENPHP_CONFIG</code> registers it as the worker. Caddy still serves static files itself. The <code>index.php</code> in your repository is untouched, so tests and <code>artisan serve</code> work as before.</p>
          <Code lang="Dockerfile" code={laravelDockerfile} />
          <p>The start-up hook caches config, routes, events and views when the container starts, so the cache holds the container's environment rather than whatever was set at build time. It runs as <code>PUID</code> through <code>run-as</code>, in every role, and adds about a second to each start.</p>
          <Code lang="docker/20-optimize" code={laravelHook} />
          <Code lang=".dockerignore" code={laravelIgnore} />
          <p>To check it's working: the log shows <code>FrankenPHP started</code> with <code>worker_threads</code> above 0, and requests after the first take a few milliseconds. Octane's worker script exits if it isn't running in worker mode, so a successful response also proves it.</p>
          <p>Without Octane, use the same Dockerfile on the <code>php-fpm-nginx</code> image, without the <code>cp</code> of the worker script, <code>OCTANE_SERVER</code> and <code>FRANKENPHP_CONFIG</code>. Its entrypoint starts s6-overlay, which would run a changed <code>command</code> as root next to nginx and php-fpm, and stop it without waiting for the current job. Give every role except the web one the plain entrypoint as well:</p>
          <Code lang="compose.yaml" code={fpmWorker} />
        </section>

        <section id="laravel-compose">
          <h3>Web, queue, scheduler, Reverb</h3>
          <p>Every role is the same image. <code>migrate</code> runs first, the rest wait for it.</p>
          <Code lang="compose.yaml" code={laravelCompose} />
          <p>Reverb is its own WebSocket server, so <code>TRUSTED_PROXIES</code> plays no part. Terminate TLS at the proxy and send <code>/app</code> and <code>/apps</code> to <code>reverb:8080</code>. The app publishes to it over the internal network with <code>REVERB_HOST</code>; the browser connects through the proxy with the <code>VITE_REVERB_*</code> values baked into your front-end build.</p>
          {!hasRedis && (<>
            <p>PHP {v} has no <code>redis</code> extension yet (see the <a href={`${base}matrix/`}>Matrix</a>), so this file sets <code>REDIS_CLIENT: predis</code>. Add the pure-PHP client to the app, or use PHP 8.5, which has the extension, and <code>phpredis</code>:</p>
            <Code lang="shell" code={predis} />
          </>)}
        </section>

        <section id="horizon">
          <h3>Horizon</h3>
          <p>Horizon replaces <code>queue</code>. It runs its own worker processes, all as <code>PUID</code>, and stops them cleanly on <code>SIGTERM</code>.</p>
          <Code lang="compose.yaml" code={horizon} />
          <p class="muted">With the <a href="#laravel-hardened">read-only overlay</a>, add <code>horizon: *hardened</code> to it.</p>
        </section>

        <section id="laravel-reload">
          <h3>Reloading and tuning</h3>
          <p>Octane isn't managing the server here, so <code>octane:status</code> and <code>octane:reload</code> report that it isn't running. Deploy by replacing containers. To restart the workers in place, without dropping connections, use FrankenPHP's admin API inside the container:</p>
          <Code lang="shell" code={workerRestart} />
          <ul>
            <li><code>MAX_REQUESTS</code>: requests each worker serves before it restarts, default <code>1000</code>. A safety net for memory leaks. In development, <code>1</code> gives a fresh app on every request.</li>
            <li>State held in statics or singletons lives as long as the worker, and each worker thread has its own. Follow Octane's rules on state.</li>
            <li><code>route:cache</code> serialises route closures, so a <code>static</code> inside a closure resets on every request. Keep long-lived state in classes.</li>
          </ul>
        </section>

        <section id="laravel-hardened">
          <h3>Read-only</h3>
          <p>An overlay for the compose file above that runs every role on a read-only root with no capabilities beyond the switch to <code>PUID</code>. <code>storage/</code> and <code>bootstrap/cache</code> become tmpfs owned by <code>PUID</code>, which is why the start-up hook creates the <code>storage/</code> directories. Only the web role runs Caddy, so only it needs <code>/config</code> and <code>/data</code>.</p>
          <Code lang="compose.hardened.yaml" code={laravelHardened} />
          <p class="muted">Files stored on the <code>local</code> or <code>public</code> disk need a volume at <code>/app/storage/app</code>, or object storage. A tmpfs loses them on restart.</p>
        </section>

        <h2 id="symfony">Symfony</h2>
        <p>Tested with Symfony 7.4, Messenger, Scheduler and Doctrine migrations.</p>

        <section id="symfony-worker">
          <h3>Worker mode</h3>
          <p>From 7.4, Symfony's runtime runs in FrankenPHP worker mode by itself. The standard <code>public/index.php</code> works as the worker, with no <code>runtime/frankenphp-symfony</code> and no <code>APP_RUNTIME</code>. On older versions, install that package and set <code>APP_RUNTIME=Runtime\FrankenPhpSymfony\Runtime</code>.</p>
          <Code lang="Dockerfile" code={symfonyDockerfile} />
          <Code lang=".dockerignore" code={symfonyIgnore} />
          <ul>
            <li>The cache is warmed at build time. It doesn't need the real <code>APP_SECRET</code> or <code>DATABASE_URL</code>; those are read from the environment when the container starts.</li>
            <li>Skip <code>composer dump-env prod</code>. It bakes the placeholder values from <code>.env</code> into the image, so a variable you forget to set falls back to a placeholder instead of failing.</li>
            <li><code>FRANKENPHP_LOOP_MAX</code>: requests each worker serves before it restarts, default <code>500</code>.</li>
            <li>The same image works on <code>php-fpm-nginx</code>: change both <code>FROM</code> lines and give the Messenger and Scheduler roles <code>entrypoint: ["docker-entrypoint.sh"]</code>. <code>FRANKENPHP_CONFIG</code> is then ignored.</li>
          </ul>
        </section>

        <section id="symfony-compose">
          <h3>Web, Messenger, Scheduler</h3>
          <p>The Scheduler's recurring messages are consumed from the <code>scheduler_default</code> transport by their own consumer. <code>--time-limit</code> and <code>--memory-limit</code> make consumers exit cleanly now and then, and <code>restart: unless-stopped</code> starts them again, which also stops memory creeping up.</p>
          <Code lang="compose.yaml" code={symfonyCompose} />
          <p class="muted">The <code>doctrine://</code> Messenger transport needs <code>symfony/doctrine-messenger</code>, which <code>symfony/orm-pack</code> doesn't install. Without it, <code>doctrine:migrations:diff</code> also leaves out the <code>messenger_messages</code> table.</p>
        </section>

        <section id="symfony-hardened">
          <h3>Read-only</h3>
          <p>The warmed cache under <code>var/cache</code> is only read. The one directory Symfony writes to at runtime is <code>var/share</code>, which holds the <code>cache.app</code> pools and the Scheduler's checkpoint. Its location is fixed when the cache is warmed, so mount over it rather than setting <code>APP_SHARE_DIR</code> at runtime.</p>
          <Code lang="compose.hardened.yaml" code={symfonyHardened} />
          <p class="muted">On a tmpfs, the Scheduler forgets its checkpoint on restart, so missed runs aren't caught up. To keep it, or to run more than one scheduler, use a volume for <code>/app/var/share</code> or move <code>cache.app</code> to Redis or the database.</p>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  .frameworks .prose section { margin-top: 56px; }
  .frameworks .prose h2 + p + section { margin-top: 28px; }
  .frameworks .prose section > h3 { margin-top: 0; }
  .frameworks .prose ul { margin: 12px 0 16px; padding-left: 20px; }
  .frameworks .prose li { margin: 6px 0; }
  .frameworks .prose table.env td:first-child { white-space: nowrap; }
</style>
