---
import Base from '../../../layouts/Base.astro';
import Bullet from '../../../components/Bullet.astro';
import Copy from '../../../components/Copy.astro';
import Timetable from '../../../components/Timetable.astro';
import Facts from '../../../components/Facts.astro';
import Examples from '../../../components/Examples.astro';
import Picker from '../../../components/Picker.astro';
import Versions from '../../../components/Versions.astro';
import CveTable from '../../../components/CveTable.astro';
import CveSummary from '../../../components/CveSummary.astro';
import { pages, type Image, buildPath, imagePath } from '../../../lib/data';

export function getStaticPaths() {
  return pages.map((img) => ({ params: { id: img.id }, props: { img } }));
}
const { img } = Astro.props as { img: Image };
const base = import.meta.env.BASE_URL;
const ref = `${img.repo}:${img.tag}`;
const cur = img.current;
const crit = cur?.cves?.filter((c) => c.severity === 'CRITICAL') ?? [];
---
<Base title={`${img.tag} · mintopia/php`} description={`${ref}: how to use it, what is in it and every recorded build.`} current="images">
  <div class="lined" data-line={img.variant === 'nginx' ? '' : img.version}>
    <Picker img={img} />
    <div class="dest-band">
      <div class="dest">
        {img.variant === 'nginx' ? <span class="bullet lg nginx">nginx</span> : <Bullet version={img.version} size="lg" />}
        <h1><small>{img.repo}</small>{img.tag}</h1>
        <Copy text={ref} label="Copy reference" primary />
      </div>
      <p class="tracks">
        {img.tags.filter((t) => t !== img.tag).length > 0 && <span class="muted">Also tagged</span>}
        {img.tags.filter((t) => t !== img.tag).map((t) => <code class="chip">{t}</code>)}
      </p>
      {img.parent && (
        <p class="note">Older patch, still rebuilt for OS and extension updates. <a href={imagePath(img.parent)}><code>{img.parent.tag}</code></a> now tracks {img.parent.patch ?? 'a newer release'}.</p>
      )}
    </div>
    <div class="detail">
      <div>
        {crit.length > 0 && (
          <section class="alert">
            <h2><span class="cve">{crit.length} critical CVE{crit.length === 1 ? '' : 's'}</span> in the current build</h2>
            <CveTable img={img} cves={crit} />
          </section>
        )}
        <h2>Use it</h2>
        <dl class="refs">
          <div><dt>Image</dt><dd><code>{ref}</code></dd><Copy text={ref} /></div>
        </dl>
        <Examples img={img} ref={ref} />
        <CveSummary img={img} build={cur} />
        <h2>Every {img.patch && `${img.patch} `}build <span class="muted count">{img.builds.length}</span></h2>
        <Timetable img={img} />
      </div>
      <aside>
        <h2>On board now</h2>
        <Facts build={cur} />
        <Versions img={img} />
      </aside>
    </div>
  </div>
</Base>
