---
import Base from '../../../../layouts/Base.astro';
import Bullet from '../../../../components/Bullet.astro';
import Copy from '../../../../components/Copy.astro';
import CveTable from '../../../../components/CveTable.astro';
import LiveLink from '../../../../components/LiveLink.astro';
import { pages, type Image, type Build, fmtTime, shortDigest, buildPath, imagePath, scannedAt } from '../../../../lib/data';

export function getStaticPaths() {
  return pages.flatMap((img) =>
    img.builds.filter((b) => b.cves?.length).map((b) => ({ params: { id: img.id, build: shortDigest(b.digest) }, props: { img, b } })),
  );
}
const { img, b } = Astro.props as { img: Image; b: Build };
const base = import.meta.env.BASE_URL;
const pinned = b.live ? `${img.repo}:${img.tag}@${b.digest}` : `${img.repo}@${b.digest}`;
---
<Base title={`CVEs · ${img.tag} · ${fmtTime(b.time)} · mintopia/php`} description={`Every known CVE in the ${img.repo}:${img.tag} build from ${fmtTime(b.time)} UTC.`} current="images">
  <div class="lined" data-line={img.variant === 'nginx' ? '' : img.version}>
    <div class="dest-band">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`${base}images/`}>Images</a><span>/</span><a href={imagePath(img)}>{img.tag}</a><span>/</span><a href={buildPath(img, b)}>{shortDigest(b.digest)}</a><span>/</span><span aria-current="page">CVEs</span>
      </nav>
      <div class="dest">
        {img.variant === 'nginx' ? <span class="bullet lg nginx">nginx</span> : <Bullet version={img.version} size="lg" />}
        <h1><small>{img.repo}{b.live ? '' : <> · was {img.tag}</>} · built {fmtTime(b.time)} UTC<span class="sr-only">, </span></small>{b.live ? img.tag : shortDigest(b.digest)}</h1>
        <Copy text={pinned} label="Copy pinned reference" primary />
      </div>
      <div class="tracks">{b.live ? <span class="status">Live</span> : <><span class="status old">Superseded</span><LiveLink img={img} /></>}</div>
    </div>
    <div class="detail">
      <div>
        <h2>CVEs <span class="muted count">{b.cves!.length}</span></h2>
        <CveTable img={img} cves={b.cves!} live={b.live ? undefined : img.current?.cves} />
      </div>
      <aside>
        <h2>Scan</h2>
        <p class="note">OS packages from a Trivy scan of the image's SBOM, PHP from php-src security advisories. Scanned {fmtTime(scannedAt!)} UTC.</p>
      </aside>
    </div>
  </div>
</Base>
