{
	skip_install_trust

	{$CADDY_SERVERS}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME::8080} {
	root {$APP_PUBLIC_PATH}
	encode zstd br gzip

	# FrankenPHP takes REMOTE_ADDR and HTTPS from the raw connection; forwarded headers reach PHP only from TRUSTED_PROXIES
	map {http.vars.trusted_proxy} {forwarded_host} {forwarded_port} {forwarded_prefix} {
		true {header.X-Forwarded-Host} {header.X-Forwarded-Port} {header.X-Forwarded-Prefix}
		default "" "" ""
	}
	map {http.vars.trusted_proxy}:{header.X-Forwarded-Proto} {forwarded_proto} {
		true:https https
		true:http http
		default {http.request.scheme}
	}
	map {forwarded_proto} {forwarded_https} {
		https on
		default ""
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server {
		env REMOTE_ADDR {client_ip}
		env HTTPS {forwarded_https}
		env REQUEST_SCHEME {forwarded_proto}
		env HTTP_X_FORWARDED_FOR {client_ip}
		env HTTP_X_FORWARDED_PROTO {forwarded_proto}
		env HTTP_X_FORWARDED_HOST {forwarded_host}
		env HTTP_X_FORWARDED_PORT {forwarded_port}
		env HTTP_X_FORWARDED_PREFIX {forwarded_prefix}
		env HTTP_FORWARDED ""
	}
}

import Caddyfile.d/*.caddyfile
