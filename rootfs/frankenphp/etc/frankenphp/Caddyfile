{
	skip_install_trust

	{$CADDY_SERVERS}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME::8080} {
	root {$APP_PUBLIC_PATH}
	encode zstd br gzip

	# FrankenPHP takes REMOTE_ADDR and HTTPS from the raw connection; forwarded headers reach PHP only from TRUSTED_PROXIES
	@untrusted not vars trusted_proxy true
	request_header @untrusted -X-Forwarded-Host
	request_header @untrusted -X-Forwarded-Port
	request_header @untrusted -X-Forwarded-Prefix
	request_header -Forwarded
	map {http.vars.trusted_proxy}:{header.X-Forwarded-Proto} {forwarded_proto} {
		true:https https
		true:http http
		default {http.request.scheme}
	}
	map {forwarded_proto} {forwarded_https} {
		https on
		default ""
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server {
		env REMOTE_ADDR {client_ip}
		env HTTPS {forwarded_https}
		env REQUEST_SCHEME {forwarded_proto}
		env HTTP_X_FORWARDED_FOR {client_ip}
		env HTTP_X_FORWARDED_PROTO {forwarded_proto}
	}
}

import Caddyfile.d/*.caddyfile
